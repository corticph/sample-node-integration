{
  "name": "sample-node-integration",
  "version": "1.0.0",
  "description": "Sample integration between Corti using Node JS",
  "main": "index.js",
  "scripts": {
    "build": "npx tsc",
    "start": "node dist/index.js",
    "dev": "concurrently \"npx tsc --watch\" \"nodemon -q dist/index.js\"",
    "test": "npm run build && node --test tests/unit.test.js tests/integration.test.js",
    "test:unit": "npm run build && node --test tests/unit.test.js",
    "test:integration": "npm run build && node --test tests/integration.test.js",
    "test:grouped-fvc": "node test-grouped-flow-value-collector-blocks-updated.js",
    "test:e2e": "node test-e2e-desktop.js"
  },
  "author": "Corti ApS",
  "license": "UNLICENSED",
  "dependencies": {
    "body-parser": "^1.20.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2"
  },
  "devDependencies": {
    "@types/express": "^4.17.19",
    "@types/node": "^20.8.6",
    "concurrently": "^8.2.1",
    "nodemon": "^3.0.1",
    "typescript": "^5.2.2"
  }
}
